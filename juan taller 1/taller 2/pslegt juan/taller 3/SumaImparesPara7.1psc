Algoritmo SumaImparesPara
    Definir N, i, suma Como Entero
    Escribir "Ingrese el valor de N:"
    Leer N
    suma <- 0
    Para i <- 1 Hasta N Con Paso 1 Hacer
        Si i MOD 2 <> 0 Entonces
            suma <- suma + i
        FinSi
    FinPara
    Escribir "La suma de impares es: ", suma
FinAlgoritmo