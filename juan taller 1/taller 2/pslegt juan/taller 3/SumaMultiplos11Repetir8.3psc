Algoritmo SumaMultiplos11Repetir
    Definir N, i, suma Como Entero
    Escribir "Ingrese la cantidad de múltiplos de 11 (N):"
    Leer N
    i <- 1
    suma <- 0
    Si N >= 1 Entonces
        Repetir
            suma <- suma + (i * 11)
            i <- i + 1
        Hasta Que i > N
    FinSi
    Escribir "La suma es: ", suma
FinAlgoritmo