Algoritmo SumarNumerosRepetir
    Definir N, i, suma Como Entero
    Escribir "Ingrese el valor de N:"
    Leer N
    i <- 1
    suma <- 0
    Si N >= 1 Entonces
        Repetir
            Escribir i
            suma <- suma + i
            i <- i + 1
        Hasta Que i > N
    FinSi
    Escribir "La suma total es: ", suma
FinAlgoritmo