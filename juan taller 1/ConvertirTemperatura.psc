Algoritmo ConvertirTemperatura
	Definir celsius, fahrenheit Como Real
	
	Escribir "Ingrese la temperatura en grados centigrados:"
	Leer celsius
	
	fahrenheit <- (celsius * 9 / 5) + 32
	
	Escribir "Temperatura en grados centigrados: ", celsius
	Escribir "Temperatura en grados Fahrenheit: ", fahrenheit
FinAlgoritmo